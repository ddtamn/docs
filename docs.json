              "components/queue",
              "components/track",
              "components/playback-speed"
            ]
          },
          {
            "group": "UI Primitives",
            "pages": [
              "ui/fader",
              "ui/knob",
              "ui/slider",
              "ui/sortable-list",
              "ui/xy-pad"
            ]
          },
          {
            "group": "Libraries",
            "pages": ["libs/audio-store", "libs/html-audio"]
          }
        ]
      }
    ]
  }
}
